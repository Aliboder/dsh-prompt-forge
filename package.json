{
  "name": "dsh-prompt-forge",
  "version": "1.2.1",
  "type": "module",
  "description": "Composer prompt refinement for DeepSeek Harness: rewrite the draft through the harness LLM, review the result, then apply it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aliboder/dsh-prompt-forge.git"
  },
  "homepage": "https://github.com/Aliboder/dsh-prompt-forge#readme",
  "scripts": {
    "test": "node test/lib.test.mjs && node test/host.test.mjs",
    "check": "node --check index.js && node --check client.js && node --check lib/config.js && node --check lib/prompt.js",
    "pack:check": "npm pack --dry-run"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
